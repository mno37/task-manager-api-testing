        {
          "name": "Create user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const random = Math.floor(Math.random() * 10000);\r\npm.environment.set(\"randomEmail\", \"user\" + random + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Response is an object (not a list)\", function () {\r\n    pm.expect(pm.response.json()).to.be.an(\"object\");\r\n});\r\n\r\npm.test(\"Response has an id\", function () {\r\n    pm.expect(pm.response.json()).to.have.property(\"id\");\r\n});\r\n\r\npm.test(\"Name matches what we sent\", function () {\r\n    pm.expect(pm.response.json().name).to.eql(\"Munira Eng\");\r\n});\r\n\r\npm.environment.set(\"userId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"Munira Eng\",\r\n  \"email\": \"{{randomEmail}}\",\r\n  \"role\": \"tester\",\r\n  \"active\": true\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3002/users",
              "protocol": "http",
              "host": [
