              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Id did not change\", function () {\r\n    pm.expect(String(pm.response.json().id)).to.eql(String(pm.environment.get(\"userId\")));\r\n});\r\n\r\npm.test(\"Name was updated\", function () {\r\n    pm.expect(pm.response.json().name).to.eql(\"Munira Updated\");\r\n});\r\n\r\npm.test(\"Role was updated\", function () {\r\n    pm.expect(pm.response.json().role).to.eql(\"senior tester\");\r\n});"
                ]
              }
            }
